# Copy to .env and fill in. Never commit .env.

# Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=
# Right-click the server icon > Copy Server ID (enable Developer Mode in Discord settings first)
GUILD_ID=

# themoviedb.org > Settings > API > "API Read Access Token" (or the v3 API key)
TMDB_TOKEN=

# Right-click channel > Copy Channel ID
CARTAZ_CHANNEL_ID=
RATE_CHANNEL_ID=
# Caption Hastings posts the movie night reminder here, 15 minutes before (leave empty to turn it off)
GENERAL_CHANNEL_ID=

DB_PATH=data/cinema.db
MAX_SUGGESTIONS=10
# Set above 0 to require a remark of at least this many characters with every /rate
MIN_REMARK_CHARS=0

# Export site/data/data.json and git push it when data changes (needs push access from this machine)
PUBLISH_ENABLED=false
PUBLISH_INTERVAL_MINUTES=10
